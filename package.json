{
  "name": "rafnexa",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-tenant project operations workspace.",
  "author": "Rafayel Karamyan",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @rafnexa/shared && concurrently -k \"node --watch --import tsx apps/api/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "build": "npm run build -w @rafnexa/shared && npm run build -w @rafnexa/api && npm run build -w @rafnexa/web",
    "start": "node apps/api/dist/index.js",
    "db:migrate": "node --import tsx apps/api/src/migrate.ts",
    "check": "npm run build && npm run typecheck:tests && npm run lint && npm run format:check && npm test",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run apps/api/src/integration.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.0.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^5.0.4"
  }
}
